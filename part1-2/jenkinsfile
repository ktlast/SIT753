pipeline {
  agent any

  environment {
    NOTIFICATION_EMAIL = 'abc1238364@gmail.com'
  }

  stages {
    stage('Checkout') {
      steps {
        git branch: 'main', url: 'https://github.com/ktlast/8.2CDevSecOps.git'
      }
    }
    stage('Install Dependencies') {
      steps {
        sh 'npm install'
      }
    }
    stage('Run Tests') {
      steps {
        sh 'npm test || true'
      }
      post {
        success {
          emailext(
            to: "${env.NOTIFICATION_EMAIL}",
            subject: "${env.JOB_NAME} #${env.BUILD_NUMBER} - Run Tests: SUCCESS",
            body: "Run Tests status: SUCCESS\nBuild: ${env.BUILD_URL}",
            attachLog: true
          )
        }
        failure {
          emailext(
            to: "${env.NOTIFICATION_EMAIL}",
            subject: "${env.JOB_NAME} #${env.BUILD_NUMBER} - Run Tests: FAILURE",
            body: "Run Tests status: FAILURE\nBuild: ${env.BUILD_URL}",
            attachLog: true
          )
        }
      }
    }
    stage('Generate Coverage Report') {
      steps {
        // Ensure coverage report exists
        sh 'npm run coverage || true'
      }
    }
    stage('NPM Audit (Security Scan)') {
      steps {
        sh 'npm audit || true'
      }
      post {
        success {
          emailext(
            to: "${env.NOTIFICATION_EMAIL}",
            subject: "${env.JOB_NAME} #${env.BUILD_NUMBER} - NPM Audit: SUCCESS",
            body: "NPM Audit status: SUCCESS\nBuild: ${env.BUILD_URL}",
            attachLog: true
          )
        }
        failure {
          emailext(
            to: "${env.NOTIFICATION_EMAIL}",
            subject: "${env.JOB_NAME} #${env.BUILD_NUMBER} - NPM Audit: FAILURE",
            body: "NPM Audit status: FAILURE\nBuild: ${env.BUILD_URL}",
            attachLog: true
          )
        }
      }
    }
  }
}
